{
  "name": "amc-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#messages": "./src/lib/paraglide/messages.js"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write --cache \"**/*.{js,ts,svelte,json,md,css,html,yml,yaml}\"",
    "lint": "prettier --check --cache \"**/*.{js,ts,svelte,json,md,css,html,yml,yaml}\" && eslint \"**/*.{js,ts,svelte}\"",
    "lint:fix": "eslint --fix \"**/*.{js,ts,svelte}\"",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "paraglide:compile": "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "proto:generate": "buf generate",
    "build:pakop": "dotnet build wasm/pakop/Pakop.csproj -c Release"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/sveltekit": "10.6.5",
    "@sveltejs/load-config": "0.2.3",
    "@types/culori": "4.0.1",
    "@types/env-ci": "3.1.4",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitest/browser": "5.0.5",
    "axe-core": "4.10.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/kanit": "5.3.0",
    "@fontsource/koulen": "5.3.0",
    "@iconify-json/material-symbols": "1.2.97",
    "@inlang/paraglide-js": "2.29.3",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tanstack/svelte-query": "6.3.6",
    "@unocss/extractor-svelte": "66.12.0",
    "@vitest/browser-playwright": "5.0.5",
    "amc-uno-css-config": "github:ASEAN-Motor-Club/uno-css-config#9ae00ce11190237610eb3f92b615773148090504",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "env-ci": "11.2.0",
    "es-toolkit": "1.53.0",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "marked": "18.1.2",
    "monaco-editor": "0.57.0",
    "ol": "10.11.0",
    "pakop": "workspace:*",
    "quaternion": "2.2.0",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "unocss": "66.12.0",
    "vite": "8.3.5",
    "vite-bundle-analyzer": "1.3.9",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
