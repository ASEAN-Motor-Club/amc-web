{
  "name": "amc-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#messages": "./src/lib/paraglide/messages.js"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write --cache \"**/*.{js,ts,svelte,json,md,css,html,yml,yaml}\"",
    "lint": "prettier --check --cache \"**/*.{js,ts,svelte,json,md,css,html,yml,yaml}\" && eslint \"**/*.{js,ts,svelte}\"",
    "lint:fix": "eslint --fix \"**/*.{js,ts,svelte}\"",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "paraglide:compile": "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "proto:generate": "buf generate",
    "build:pakop": "dotnet build wasm/pakop/Pakop.csproj -c Release"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/sveltekit": "10.6.7",
    "@sveltejs/load-config": "0.2.3",
    "@types/culori": "4.0.1",
    "@types/env-ci": "3.1.4",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/browser": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-storybook": "10.6.7",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.7",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/kanit": "5.3.0",
    "@fontsource/koulen": "5.3.0",
    "@iconify-json/material-symbols": "1.2.98",
    "@iconify/tailwind4": "1.2.3",
    "@inlang/paraglide-js": "3.2.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/svelte-query": "6.4.1",
    "@vitest/browser-playwright": "5.1.0",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "env-ci": "11.2.0",
    "es-toolkit": "1.53.2",
    "gsap": "3.15.1",
    "lottie-web": "5.13.0",
    "marked": "18.2.0",
    "monaco-editor": "0.57.0",
    "pakop": "workspace:*",
    "quaternion": "2.2.0",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "vite": "8.3.7",
    "vite-bundle-analyzer": "1.3.9",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
