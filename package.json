{
  "name": "amc-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write --cache \"**/*.{js,ts,svelte,json,md,css,html}\"",
    "lint": "prettier --check --cache \"**/*.{js,ts,svelte,json,md,css,html}\" && eslint \"**/*.{js,ts,svelte}\"",
    "lint:fix": "eslint --fix \"**/*.{js,ts,svelte}\"",
    "test:unit": "vitest",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "paraglide:compile": "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "proto:generate": "buf generate",
    "build:pakop": "dotnet build wasm/pakop/Pakop.csproj -c Release"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/sveltekit": "10.4.6",
    "@types/env-ci": "3.1.4",
    "@types/node": "24.13.2",
    "@vitest/browser": "4.1.10",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "lefthook": "2.1.9",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "storybook": "10.4.6",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "vitest-browser-svelte": "2.2.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@fontsource-variable/noto-sans": "5.2.10",
    "@fontsource-variable/noto-sans-jp": "5.2.10",
    "@fontsource-variable/noto-sans-kr": "5.2.10",
    "@fontsource-variable/noto-sans-mono": "5.2.10",
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@fontsource-variable/noto-sans-thai": "5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/great-vibes": "^5.2.8",
    "@fontsource/kanit": "5.2.8",
    "@fontsource/koulen": "5.2.7",
    "@iconify-json/material-symbols": "1.2.82",
    "@inlang/paraglide-js": "2.20.2",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "7.1.4",
    "@unocss/extractor-svelte": "66.7.4",
    "@vitest/browser-playwright": "4.1.10",
    "amc-uno-css-config": "github:ASEAN-Motor-Club/uno-css-config#9ae00ce11190237610eb3f92b615773148090504",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.11",
    "env-ci": "11.2.0",
    "es-toolkit": "1.49.0",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "marked": "18.0.5",
    "ol": "10.9.0",
    "pakop": "workspace:*",
    "quaternion": "2.2.0",
    "svelte": "5.56.4",
    "tailwind-merge": "3.6.0",
    "unocss": "66.7.4",
    "vite": "8.1.3",
    "vite-bundle-analyzer": "1.3.8",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
